{
  "manifest_version": 3,
  "name": "JSON Prettifier",
  "version": "1.0.0",
  "description": "Auto-formats raw JSON pages with syntax highlighting",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "modules/detector.js",
        "modules/formatter.js",
        "modules/tree-builder.js",
        "modules/tree-renderer.js",
        "modules/viewer.js",
        "modules/searcher.js",
        "content.js"
      ],
"run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["style.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
